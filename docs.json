{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "msg.Hello",
  "colors": {
    "primary": "#A01441",
    "light": "#A01441",
    "dark": "#A01441"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/msg-hello-light.svg",
    "dark": "/logo/msg-hello-dark.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "de",
        "default": true,
        "tabs": [
          {
            "tab": "Handbuch",
            "groups": [
              { "group": "Einstieg", "pages": ["index", "erste-schritte"] },
              { "group": "Agenten & Gespräche", "pages": ["agenten-verwalten", "flows-bauen", "agenten-testen"] },
              { "group": "Integration", "pages": ["connectoren"] },
              { "group": "Im Alltag", "pages": ["anrufe-auswerten", "einstellungen", "benutzer-team"] },
              { "group": "Referenz", "pages": ["glossar", "roadmap"] }
            ]
          }
        ]
      },
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Guide",
            "groups": [
              { "group": "Getting Started", "pages": ["en/index", "en/erste-schritte"] },
              { "group": "Agents & Conversations", "pages": ["en/agenten-verwalten", "en/flows-bauen", "en/agenten-testen"] },
              { "group": "Integration", "pages": ["en/connectoren"] },
              { "group": "Daily Use", "pages": ["en/anrufe-auswerten", "en/einstellungen", "en/benutzer-team"] },
              { "group": "Reference", "pages": ["en/glossar", "en/roadmap"] }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Zum Portal",
      "href": "https://portal.msg-hello.example"
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.msg.group"
    }
  }
}
